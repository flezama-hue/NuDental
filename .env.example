# Copia este archivo como .env. Nunca subas .env ni credenciales reales a GitHub.
DB_DRIVER=pglite
PGLITE_PATH=./.local-data/nudental
API_PORT=3001
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DB_POOL_MAX=10

# Clave solo para cuentas ficticias locales. Entre 12 y 128 caracteres.
LOCAL_DEMO_PASSWORD=

# Alternativa PostgreSQL local:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://nudental_local:TU_CLAVE@127.0.0.1:5432/nudental_local
# POSTGRES_PASSWORD=TU_CLAVE

# Se habilitarán cuando existan contratos y credenciales del proveedor:
# MRP_BASE_URL=
# MRP_SERVICE_TOKEN=
# PANDA_API_BASE_URL=
# PANDA_API_KEY=
# WHATSAPP_PROVIDER=
# WHATSAPP_API_TOKEN=
# OBJECT_STORAGE_BUCKET=
